{
    "name": "semitexa/tenancy",
    "description": "Semitexa Tenancy - tenant resolution, scoped context, and multi-tenant application support",
    "type": "semitexa-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.09.27.0404 || dev-master"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Tenancy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Tenancy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "extends": null
        },
        "semitexa": {
            "floors": {
                "semitexa/core": "2026.09.27.0404"
            }
        }
    },
    "keywords": [
        "semitexa",
        "tenancy",
        "multi-tenant",
        "tenant-context",
        "isolation"
    ]
}
